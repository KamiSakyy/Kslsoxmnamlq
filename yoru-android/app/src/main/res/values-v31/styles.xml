<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#A78BFA</item>
        <item name="android:windowBackground">#09090b</item>
        <item name="android:colorBackground">#09090b</item>
        <item name="android:textColorPrimary">#FAFAFA</item>
        <item name="android:textColorSecondary">#71717A</item>
        <item name="android:statusBarColor">#09090b</item>
        <item name="android:navigationBarColor">#09090b</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowSplashScreenBackground">#09090b</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_tsuyu</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#17171A</item>
        <item name="android:windowSplashScreenAnimationDuration">260</item>
